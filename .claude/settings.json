{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(agent-browser:*)",
      "Bash(opensrc path *)",
      "Bash(pkill -f agent-browser:*)",
      "Read(/private/tmp/*)",
      "Read(~/.opensrc/**)",
      "Read(**/node_modules/**)",
      "mcp__figma-desktop__*",
      "mcp__ark-ui__*"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "editorMode": "vim",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true
}
