#!/bin/sh
set -eu

git fetch --prune

gone_branches=$(git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | grep '\[gone\]' | cut -d' ' -f1)

[ -n "$gone_branches" ] || exit 0

git worktree list --porcelain | awk '
  /^worktree / { path=$2 }
  /^branch / { branch=$2; sub("refs/heads/", "", branch); print path, branch }
' | while read -r path branch; do
  for gone in $gone_branches; do
    if [ "$branch" = "$gone" ]; then
      id=$(herdr worktree list --cwd "$path" 2>/dev/null | jq -r --arg p "$path" '.result.worktrees[] | select(.path == $p) | .open_workspace_id // empty')
      if [ -n "$id" ]; then
        herdr workspace close "$id" >/dev/null 2>&1 || true
      fi
      git worktree remove "$path"
    fi
  done
done
