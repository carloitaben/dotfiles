#!/bin/sh
set -eu

branch="$1"
base="$2"

repo_root=$(git rev-parse --show-toplevel)
path="$(dirname "$repo_root")/$branch"

git worktree add "$path" "$base" -b "$branch"

if [ "${HERDR_ENV:-}" = "1" ]; then
  parent=$(herdr worktree list | jq -r '.result.source.source_workspace_id')
  herdr worktree open --workspace "$parent" --path "$path" --focus >/dev/null
fi
