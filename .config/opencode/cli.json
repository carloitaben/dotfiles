{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "vesper"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d"
  },
  "session": {
    "permissions": "autoaccept"
  },
  "plugins": [
    "opencode-plugin-usage",
    {
      "package": "./tui-plugins/codex-resets",
      "options": {
        "expiryPrompt": {
          "enabled": true,
          "withinMinutes": 60
        }
      }
    }
  ]
}
