{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "agents": {
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/opt/homebrew/Cellar/neovim/*/share/nvim/runtime/doc/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.opensrc/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "opensrc *",
      "effect": "allow"
    }
  ]
}
