#!/bin/sh
# lazygit-with-sync — runs lazygit with worktree-sync's reconciliation tied to
# the popup's own lifecycle, instead of a separate background daemon.
#
# On open: one sync pass, so worktrees created since the last lazygit session
# (by an agent, or from a previous lazygit session that got closed some other
# way) are already adopted before you look at the sidebar.
# While open: sync.sh polls in the background, backgrounded as a child of this
# script — so it dies with the popup automatically (pty close -> SIGHUP), the
# EXIT trap below is just the deterministic path for a normal `q` quit.
# On close: kill the poller, one more sync pass to catch whatever you just did
# in lazygit (new worktree via `n`, removed one via `d`).

set -eu

PLUGIN_DIR="$HOME/.config/herdr/plugins/worktree-sync"

sh "$PLUGIN_DIR/sync.sh" once >/dev/null 2>&1 || true

sh "$PLUGIN_DIR/sync.sh" loop >/dev/null 2>&1 &
poll_pid=$!
trap 'kill "$poll_pid" 2>/dev/null || true; sh "$PLUGIN_DIR/sync.sh" once >/dev/null 2>&1 || true' EXIT

lazygit
